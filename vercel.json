{
    "version": 2,
    "builds": [
        {
            "src": "FronND/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        },
        {
            "src": "BackND/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.)",
            "dest": "BackND/index.js"
        },
        {
            "src": "/(.)",
            "dest": "FronND/dist/index.html"
        }
    ]
}